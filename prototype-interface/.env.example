# ==========================================================
# LINGUAFLOW: Environment Configuration
# ==========================================================

# 1. Supabase PostgreSQL Connection String (Transaction Pooler or Direct URI)
# Find this in your Supabase Dashboard > Project Settings > Database > Connection String > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 2. Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Authentication & JWT Security
JWT_SECRET=linguaflow-secret-jwt-key-study-group-2026

# 4. Vocabulary Card Images (optional)
# Get a free access key at https://unsplash.com/developers
# If not set, the app falls back to the free Openverse API (no key required).
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# 5. Google Gemini AI Model (gemini-1.5-flash)
# Used for Vietnamese definitions and supplementing missing dictionary fields (examples, IPA, CEFR, etc.)
GEMINI_API_KEY=your-gemini-api-key-here
