# ==========================================================
# LINGUAFLOW: Environment Configuration
# ==========================================================

# 1. Supabase PostgreSQL Connection String (Transaction Pooler or Direct URI)
# Find this in your Supabase Dashboard > Project Settings > Database > Connection String > URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 2. Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Authentication & JWT Security
JWT_SECRET=linguaflow-secret-jwt-key-study-group-2026
