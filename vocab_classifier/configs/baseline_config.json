{
  "seed": 42,
  "train_path": "data/processed/train.jsonl",
  "val_path": "data/processed/val.jsonl",
  "test_path": "data/processed/test.jsonl",
  "taxonomy_path": "data/taxonomy/taxonomy.json",
  "output_dir": "artifacts/baselines",
  "tfidf": {
    "ngram_range": [1, 2],
    "max_features": 30000,
    "min_df": 2,
    "sublinear_tf": true
  },
  "minilm": {
    "model_name": "sentence-transformers/all-MiniLM-L6-v2",
    "max_length": 192,
    "batch_size": 64,
    "pooling": "mean",
    "normalize": true
  },
  "classifiers": {
    "tfidf_logreg": {
      "C": 2.0,
      "max_iter": 1000,
      "class_weight": "balanced"
    },
    "tfidf_svm": {
      "C": 1.0,
      "max_iter": 2000,
      "class_weight": "balanced"
    },
    "frozen_minilm_logreg": {
      "C": 2.0,
      "max_iter": 1000,
      "class_weight": "balanced"
    }
  }
}
