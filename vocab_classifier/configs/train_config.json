{
  "seed": 42,
  "model_config_path": "configs/model_config.json",
  "train_path": "data/processed/train.jsonl",
  "val_path": "data/processed/val.jsonl",
  "test_path": "data/processed/test.jsonl",
  "benchmark_test_path": "data/processed/benchmark_test.jsonl",
  "taxonomy_path": "data/taxonomy/taxonomy.json",
  "output_dir": "artifacts/minilm_finetuned",
  "experiments_dir": "artifacts/experiments",
  "max_length": 128,
  "batch_size": 32,
  "eval_batch_size": 64,
  "epochs": 4,
  "patience": 2,
  "early_stopping_metric": "mean_macro_f1",
  "encoder_lr": 3e-5,
  "head_lr": 3e-4,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "max_grad_norm": 1.0,
  "class_weight_alpha": 0.25,
  "mask_untrusted_subtopics": true,
  "teacher_forcing_prob": 0.5,
  "freeze_bottom_layers": 0
}
